package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
set ::WINDOWS 0
set ::LINUX 0
set ::MAC 0
source [file join $root rghost.vfs lib app-ghost util.tcl]

test validate-port-1.1 {rejects invalid and reserved adjacent port} -body {
    list [ValidatePort 3773] [ValidatePort 65535] [ValidatePort abc]
} -result {1 0 0}

test format-data-1.1 {formats byte quantities} -body {
    list [FormatData 0] [FormatData 1025] [FormatData 1048577]
} -result {0 1.0KB 1.0MB}

test format-data-1.2 {formats exact unit boundaries} -body {
    list [FormatData 1024] [FormatData 1048576] [FormatData 1073741824]
} -result {1.0KB 1.0MB 1.0GB}

test format-elapsed-1.1 {formats exact time boundaries} -body {
    list [FormatElapsed 60] [FormatElapsed 3600] [FormatElapsed 86400]
} -result {1.0m 1.0h 1.0d}

test session-totals-1.1 {persists only deltas between saves} -body {
    array set settings {
        sessions 1 runtime 100 actual_down 1000 actual_up 2000
        reported_down 3000 reported_up 4000
    }
    array set baseline {
        actual_down 0 actual_up 0 reported_down 0 reported_up 0
    }
    array set current {
        actual_down 10 actual_up 20 reported_down 30 reported_up 40
    }
    AddSessionTotals settings current baseline 5
    AddSessionTotals settings current baseline 5
    list $settings(sessions) $settings(runtime) $settings(actual_down) \
        $settings(actual_up) $settings(reported_down) $settings(reported_up)
} -result {1 110 1010 2020 3030 4040}

test version-compare-1.1 {compares normalized semantic version components} -body {
    list [version_compare 0.19 0.20] [version_compare 1.2 1.2.0] \
        [version_compare 2.0 1.9.9] [version_compare 1.2.2 v1.2.3-beta]
} -result {1 0 0 1}

cleanupTests
